# Öffentliche Basis-URL der App (Stripe Redirects, E-Mails)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Zoom Terminbuchung (Success-Page CTA + DWA-Funnel)
NEXT_PUBLIC_ZOOM_SCHEDULER_URL=https://scheduler.zoom.us/aemanie-gmbh/30-minuten-mit-aemanie-gmbh-herr-manie

# DWA-Funnel: n8n Projektanalyse (Workflow: project-solutions-v1, Webhook-Pfad)
# Beispiel: https://<deine-n8n-domain>/webhook/project-solutions-v1
N8N_WEBHOOK_PROJECT_ANALYSIS_URL=

# StarterWelle-Funnel: n8n Research (industry-questions-v2, seo-keywords-v2, competitor-design-v3)
N8N_WEBHOOK_INDUSTRY_QUESTIONS_URL=https://<n8n-host>/webhook/industry-questions-v1
N8N_WEBHOOK_SEO_KEYWORDS_URL=https://<n8n-host>/webhook/seo-keywords-v2
N8N_WEBHOOK_COMPETITOR_DESIGN_URL=https://<n8n-host>/webhook/competitor-design-v3
# Optional: Legacy-Research-Webhook
N8N_RESEARCH_WEBHOOK_URL=
# Performance nach competitor-design / industry-questions (site-performance-v1, Funnel-5 Tab)
N8N_WEBHOOK_SITE_PERFORMANCE_URL=https://<n8n-host>/webhook/site-performance-v1

# Blog-Pipeline seo-01…seo-06 (WebWelle + Kunden-Blog) — in Coolify App-Env setzen
N8N_BASE_URL=https://<n8n-host>
N8N_WEBHOOK_SEO_01_URL=https://<n8n-host>/webhook/seo-01-research-project-setup-discovery
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_SEO_01_URL=
# Legacy-Alias (optional, Fallback für seo-01)
N8N_WEBHOOK_BLOG_ORCHESTRATOR_URL=
# n8n-interne Kette (seo-04 → seo-06), Basis ohne trailing slash
# Interne n8n-Kette seo-02…06 (in n8n-Instanz-Env UND optional hier für Scripts)
# Coolify n8n-App: N8N_INTERNAL_WEBHOOK_BASE=https://<n8n-host>/webhook
N8N_INTERNAL_WEBHOOK_BASE=
# API-Key für /api/blog/publish (System A, WebWelle-Pfad in seo-06)
N8N_API_KEY=
# HMAC-Secret für article-ready + job-completed Callbacks
N8N_WEBHOOK_SECRET=
# OpenRouter (seo-04 Schreib-Workflow in n8n)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-pro

# Stripe (Live oder Test – Keys müssen zum gleichen Konto passen)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Funnel Einmalpreise (one_time, netto) – Price-IDs aus Stripe Dashboard
STRIPE_PRICE_STARTERWELLE=price_...
STRIPE_PRICE_SEO_PROFI=price_...
STRIPE_PRICE_BLOG_BUNDLE_10=price_...
STRIPE_PRICE_BRANDING=price_...
STRIPE_PRICE_ANIMATION=price_...

# Optional: Funnel-5 Test-Checkout (0,50 €, Stripe-Minimum) – vor Go-Live auf false setzen
FUNNEL_CHECKOUT_USE_TEST_PRICE=false
STRIPE_PRICE_FUNNEL_TEST=price_1TifmbJ8MIbotcdAOhAmN7cU
NEXT_PUBLIC_FUNNEL_TEST_CHECKOUT=false
