# Öffentliche Basis-URL der App (Stripe Redirects, E-Mails)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Zoom Terminbuchung (Success-Page CTA)
NEXT_PUBLIC_ZOOM_SCHEDULER_URL=https://scheduler.zoom.us/aemanie-gmbh/30-minuten-mit-aemanie-gmbh-herr-manie

# Stripe (Live oder Test – Keys müssen zum gleichen Konto passen)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Funnel Einmalpreise (one_time, netto) – Price-IDs aus Stripe Dashboard
STRIPE_PRICE_STARTERWELLE=price_...
STRIPE_PRICE_SEO_PROFI=price_...
STRIPE_PRICE_BLOG_BUNDLE_10=price_...
STRIPE_PRICE_BRANDING=price_...
STRIPE_PRICE_ANIMATION=price_...

# Optional: Funnel-5 Test-Checkout (0,01 €) – vor Go-Live auf false setzen
FUNNEL_CHECKOUT_USE_TEST_PRICE=false
STRIPE_PRICE_FUNNEL_TEST=price_...
NEXT_PUBLIC_FUNNEL_TEST_CHECKOUT=false
